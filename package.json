{
  "name": "fdunav",
  "version": "1.0.0",
  "private": true,
  "description": "FduNav",
  "author": "CPJiNan",
  "contributors": [
    "yutong",
    "SlothAdrift",
    "Camellia"
  ],
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && npx --yes electron-builder@26.0.12 --win --x64 --publish never",
    "build:mac": "npm run build && npx --yes electron-builder@26.0.12 --mac --arm64 --publish never",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
